{
  "name": "stratify-mcp",
  "version": "0.1.2",
  "mcpName": "site.aeon-labs/stratify",
  "description": "JS/TS client and stdio-to-HTTP bridge for the Stratify options-backtesting MCP server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Srinath-exe/stratify-mcp.git",
    "directory": "packages/stratify-npm"
  },
  "bugs": {
    "url": "https://github.com/Srinath-exe/stratify-mcp/issues"
  },
  "type": "module",
  "main": "./dist/client.js",
  "types": "./dist/client.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "bin": {
    "stratify-mcp": "dist/bin.js",
    "stratify-mcp-proxy": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "pretest": "npm run build:test",
    "test": "node --test dist-test/test/*.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0"
  },
  "homepage": "https://stratify.aeon-labs.site",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "options",
    "backtesting",
    "nifty",
    "trading",
    "claude"
  ]
}
