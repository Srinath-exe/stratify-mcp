# Copy to .env and fill in. .env is gitignored; never commit a filled copy.

# REQUIRED. The scrypt salt for every API-key hash. server/run.sh refuses to start
# without it, because the in-code default is a development value published in this
# repository. Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Changing this invalidates every existing API key. There is no migration path — that is
# the point of a pepper.
STRATIFY_KEY_PEPPER=

# ClickHouse. Per-tier users whose visible date range is a row policy; see
# data/schema/70_tiers.sql. Leave CLICKHOUSE_PASSWORD blank: the service must never hold
# the admin user, which carries access_management plus FILE, URL, S3 and REMOTE.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_PASSWORD=
CLICKHOUSE_FREE_PASSWORD=
CLICKHOUSE_PAID_PASSWORD=

# Google sign-in for the dashboard. Optional — without these the site still runs and the
# MCP endpoint is unaffected; only the browser sign-in route is disabled.
# The redirect URI registered in Google Cloud Console must be exactly
# <STRATIFY_PUBLIC_BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URLs. Human-facing links (reports, dashboard) resolve to the first; MCP clients
# are always pointed at the second, regardless of which host served the request.
STRATIFY_PUBLIC_BASE_URL=http://localhost:8792
STRATIFY_PUBLIC_MCP_URL=http://localhost:8792/mcp

# Browser Origin allow-list, comma-separated. ADDS to DEFAULT_BROWSER_ORIGINS in
# server/app.py rather than replacing it.
STRATIFY_ALLOWED_ORIGINS=

# Set to 1 only when a reverse proxy you control sits in front. It gates whether
# X-Real-IP and X-Forwarded-For are trusted at all for signup throttling.
STRATIFY_BEHIND_PROXY=

# Durable service state: accounts, key hashes, usage, reports.
STRATIFY_SERVICE_DB=server/state/service.sqlite

# Runtime inputs this repository does not ship. See vendor/README.md.
STRATIFY_SIGNALS_PATH=vendor/signals.py
STRATIFY_MARGIN_CALIBRATION=vendor/margin_calibration.json
# STRATIFY_PAPER_TRADING_DB=vendor/paper_trades.sqlite

# Logs method name, header NAMES and user-agent — never a key value. Off by default.
# STRATIFY_TRACE=1
